---
interface Props {
  initialMode?: 'finder' | 'calculator' | 'resize' | 'crop' | 'solver';
  defaultRatioW?: number;
  defaultRatioH?: number;
  defaultWidth?: number;
  defaultHeight?: number;
  title?: string;
  subtitle?: string;
}

const {
  initialMode = 'finder',
  defaultRatioW = 16,
  defaultRatioH = 9,
  defaultWidth = 1920,
  defaultHeight = 1080,
  title,
  subtitle,
} = Astro.props;
---

<section id="workbench" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Workbench Header -->
  {title && (
    <div class="mb-6 text-center">
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717]">{title}</h2>
      {subtitle && <p class="text-sm text-[#4d4d4d] mt-1.5 max-w-2xl mx-auto">{subtitle}</p>}
    </div>
  )}

  <div class="bg-[#ffffff] rounded-xl border border-[#ebebeb] whisper-shadow overflow-hidden">
    <!-- Tool Navigation Bar -->
    <div class="flex items-center gap-1 p-2 bg-[#fafafa] border-b border-[#ebebeb] overflow-x-auto no-scrollbar">
      <button
        type="button"
        data-tool-tab="finder"
        class={`tool-tab px-3.5 py-2 text-xs font-medium rounded-md transition-all flex items-center gap-1.5 whitespace-nowrap cursor-pointer ${
          initialMode === 'finder' ? 'bg-[#ffffff] text-[#171717] shadow-xs font-semibold' : 'text-[#4d4d4d] hover:text-[#171717] hover:bg-[#ebebeb]/50'
        }`}
      >
        <svg class="w-4 h-4 text-[#171717]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        <span>Image Ratio Finder</span>
      </button>

      <button
        type="button"
        data-tool-tab="calculator"
        class={`tool-tab px-3.5 py-2 text-xs font-medium rounded-md transition-all flex items-center gap-1.5 whitespace-nowrap cursor-pointer ${
          initialMode === 'calculator' ? 'bg-[#ffffff] text-[#171717] shadow-xs font-semibold' : 'text-[#4d4d4d] hover:text-[#171717] hover:bg-[#ebebeb]/50'
        }`}
      >
        <svg class="w-4 h-4 text-[#171717]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
        </svg>
        <span>Aspect Calculator</span>
      </button>

      <button
        type="button"
        data-tool-tab="resize"
        class={`tool-tab px-3.5 py-2 text-xs font-medium rounded-md transition-all flex items-center gap-1.5 whitespace-nowrap cursor-pointer ${
          initialMode === 'resize' ? 'bg-[#ffffff] text-[#171717] shadow-xs font-semibold' : 'text-[#4d4d4d] hover:text-[#171717] hover:bg-[#ebebeb]/50'
        }`}
      >
        <svg class="w-4 h-4 text-[#171717]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
        </svg>
        <span>Proportional Resizer</span>
      </button>

      <button
        type="button"
        data-tool-tab="crop"
        class={`tool-tab px-3.5 py-2 text-xs font-medium rounded-md transition-all flex items-center gap-1.5 whitespace-nowrap cursor-pointer ${
          initialMode === 'crop' ? 'bg-[#ffffff] text-[#171717] shadow-xs font-semibold' : 'text-[#4d4d4d] hover:text-[#171717] hover:bg-[#ebebeb]/50'
        }`}
      >
        <svg class="w-4 h-4 text-[#171717]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
        </svg>
        <span>Crop & Framing</span>
      </button>

      <button
        type="button"
        data-tool-tab="solver"
        class={`tool-tab px-3.5 py-2 text-xs font-medium rounded-md transition-all flex items-center gap-1.5 whitespace-nowrap cursor-pointer ${
          initialMode === 'solver' ? 'bg-[#ffffff] text-[#171717] shadow-xs font-semibold' : 'text-[#4d4d4d] hover:text-[#171717] hover:bg-[#ebebeb]/50'
        }`}
      >
        <svg class="w-4 h-4 text-[#171717]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
        </svg>
        <span>Width ↔ Height</span>
      </button>
    </div>

    <!-- Main Workspace Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-0 divide-y lg:divide-y-0 lg:divide-x divide-[#ebebeb]">
      <!-- Left Panel: Controls & Inputs -->
      <div class="lg:col-span-7 p-6 sm:p-8 space-y-6">
        
        <!-- MODE 1: IMAGE RATIO FINDER -->
        <div id="panel-finder" class="tool-panel space-y-5">
          <div>
            <div class="flex items-center justify-between">
              <label class="block text-xs font-mono uppercase tracking-wider text-[#171717] font-semibold">
                Drop or Browse Any Image
              </label>
              <span class="text-[11px] font-mono text-[#8f8f8f]">Supports PNG, JPG, WebP, SVG, AVIF</span>
            </div>
            
            <!-- Drag & Drop Zone -->
            <div
              id="image-dropzone"
              class="mt-2 border-2 border-dashed border-[#ebebeb] hover:border-[#171717] transition-all rounded-lg p-6 text-center cursor-pointer bg-[#fafafa] hover:bg-[#ffffff] group relative"
            >
              <input type="file" id="image-file-input" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
              <div class="flex flex-col items-center justify-center pointer-events-none">
                <div class="w-10 h-10 rounded-full bg-[#f2f2f2] group-hover:bg-[#ebebeb] flex items-center justify-center text-[#171717] mb-2 transition-colors">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                  </svg>
                </div>
                <p class="text-sm font-medium text-[#171717]">
                  Drag and drop an image here, or <span class="text-[#0070f3] underline underline-offset-2">browse</span>
                </p>
                <p class="text-xs text-[#8f8f8f] mt-1">100% private. Stays directly on your machine.</p>
              </div>
            </div>
          </div>

          <!-- Sample Images Quick Load -->
          <div class="flex items-center gap-2 text-xs text-[#4d4d4d]">
            <span class="text-[11px] font-mono text-[#8f8f8f]">Try sample:</span>
            <button type="button" data-sample-size="1920x1080" class="sample-btn px-2 py-1 rounded bg-[#f2f2f2] hover:bg-[#ebebeb] text-[#171717] font-mono transition-colors">16:9 FHD</button>
            <button type="button" data-sample-size="1080x1920" class="sample-btn px-2 py-1 rounded bg-[#f2f2f2] hover:bg-[#ebebeb] text-[#171717] font-mono transition-colors">9:16 Reel</button>
            <button type="button" data-sample-size="1080x1080" class="sample-btn px-2 py-1 rounded bg-[#f2f2f2] hover:bg-[#ebebeb] text-[#171717] font-mono transition-colors">1:1 Square</button>
            <button type="button" data-sample-size="2048x1536" class="sample-btn px-2 py-1 rounded bg-[#f2f2f2] hover:bg-[#ebebeb] text-[#171717] font-mono transition-colors">4:3 iPad</button>
          </div>

          <!-- Detected Specs Card -->
          <div id="image-detected-card" class="bg-[#fafafa] rounded-lg border border-[#ebebeb] p-4 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-medium text-[#8f8f8f] uppercase">Extracted Image Metrics</span>
              <span id="detected-orientation-badge" class="px-2 py-0.5 rounded-full text-[11px] font-mono font-medium bg-[#ffffff] border border-[#ebebeb] text-[#171717]">
                Landscape 🖥️
              </span>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-1">
              <div class="bg-white p-2.5 rounded border border-[#ebebeb]">
                <div class="text-[11px] text-[#8f8f8f] font-mono">Dimensions</div>
                <div id="detected-dims" class="text-sm font-semibold text-[#171717] font-mono mt-0.5">1920 × 1080</div>
              </div>
              <div class="bg-white p-2.5 rounded border border-[#ebebeb]">
                <div class="text-[11px] text-[#8f8f8f] font-mono">Aspect Ratio</div>
                <div id="detected-ratio" class="text-sm font-semibold text-[#171717] font-mono mt-0.5">16:9</div>
              </div>
              <div class="bg-white p-2.5 rounded border border-[#ebebeb]">
                <div class="text-[11px] text-[#8f8f8f] font-mono">Decimal Ratio</div>
                <div id="detected-decimal" class="text-sm font-semibold text-[#171717] font-mono mt-0.5">1.78:1</div>
              </div>
              <div class="bg-white p-2.5 rounded border border-[#ebebeb]">
                <div class="text-[11px] text-[#8f8f8f] font-mono">Megapixels</div>
                <div id="detected-mp" class="text-sm font-semibold text-[#171717] font-mono mt-0.5">2.1 MP</div>
              </div>
            </div>

            <!-- Action shortcuts to send image to Resizer or Cropper -->
            <div class="pt-2 flex items-center gap-2">
              <button
                type="button"
                id="send-to-crop-btn"
                class="px-3 py-1.5 rounded-md bg-[#ffffff] border border-[#ebebeb] hover:border-[#171717] text-xs font-medium text-[#171717] transition-all cursor-pointer flex items-center gap-1.5"
              >
                <span>Calculate Crop</span>
                <span class="text-[#8f8f8f]">→</span>
              </button>
              <button
                type="button"
                id="send-to-resize-btn"
                class="px-3 py-1.5 rounded-md bg-[#ffffff] border border-[#ebebeb] hover:border-[#171717] text-xs font-medium text-[#171717] transition-all cursor-pointer flex items-center gap-1.5"
              >
                <span>Resize Proportionally</span>
                <span class="text-[#8f8f8f]">→</span>
              </button>
            </div>
          </div>
        </div>

        <!-- MODE 2: ASPECT RATIO CALCULATOR -->
        <div id="panel-calculator" class="tool-panel space-y-5 hidden">
          <!-- Preset Selector Bar -->
          <div>
            <label class="block text-xs font-mono uppercase tracking-wider text-[#171717] font-semibold mb-2">
              Standard Ratio Presets
            </label>
            <div class="flex flex-wrap gap-1.5">
              <button type="button" data-preset="16:9" class="calc-preset-btn px-2.5 py-1 text-xs font-mono rounded border border-[#171717] bg-[#171717] text-white">16:9 HD</button>
              <button type="button" data-preset="9:16" class="calc-preset-btn px-2.5 py-1 text-xs font-mono rounded border border-[#ebebeb] bg-white text-[#171717] hover:border-[#171717]">9:16 Reel</button>
              <button type="button" data-preset="1:1" class="calc-preset-btn px-2.5 py-1 text-xs font-mono rounded border border-[#ebebeb] bg-white text-[#171717] hover:border-[#171717]">1:1 Square</button>
              <button type="button" data-preset="4:3" class="calc-preset-btn px-2.5 py-1 text-xs font-mono rounded border border-[#ebebeb] bg-white text-[#171717] hover:border-[#171717]">4:3 Standard</button>
              <button type="button" data-preset="3:2" class="calc-preset-btn px-2.5 py-1 text-xs font-mono rounded border border-[#ebebeb] bg-white text-[#171717] hover:border-[#171717]">3:2 DSLR</button>
              <button type="button" data-preset="21:9" class="calc-preset-btn px-2.5 py-1 text-xs font-mono rounded border border-[#ebebeb] bg-white text-[#171717] hover:border-[#171717]">21:9 Ultrawide</button>
              <button type="button" data-preset="4:5" class="calc-preset-btn px-2.5 py-1 text-xs font-mono rounded border border-[#ebebeb] bg-white text-[#171717] hover:border-[#171717]">4:5 Post</button>
            </div>
          </div>

          <!-- Ratio Inputs (Width : Height) -->
          <div class="p-4 rounded-lg bg-[#fafafa] border border-[#ebebeb] space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono uppercase text-[#171717] font-semibold">Aspect Ratio Proportion</span>
              <span class="text-[11px] font-mono text-[#8f8f8f]">Simplified Ratio (W:H)</span>
            </div>
            <div class="grid grid-cols-2 gap-3 items-center">
              <div>
                <label for="input-ratio-w" class="block text-[11px] font-mono text-[#8f8f8f] mb-1">Ratio Width</label>
                <input
                  type="number"
                  id="input-ratio-w"
                  value={defaultRatioW}
                  min="1"
                  step="any"
                  class="w-full h-10 px-3 rounded-md bg-white border border-[#ebebeb] focus:border-[#171717] focus:outline-none text-sm font-mono text-[#171717]"
                />
              </div>
              <div>
                <label for="input-ratio-h" class="block text-[11px] font-mono text-[#8f8f8f] mb-1">Ratio Height</label>
                <input
                  type="number"
                  id="input-ratio-h"
                  value={defaultRatioH}
                  min="1"
                  step="any"
                  class="w-full h-10 px-3 rounded-md bg-white border border-[#ebebeb] focus:border-[#171717] focus:outline-none text-sm font-mono text-[#171717]"
                />
              </div>
            </div>
          </div>

          <!-- Pixel Dimensions Inputs -->
          <div class="p-4 rounded-lg bg-[#fafafa] border border-[#ebebeb] space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono uppercase text-[#171717] font-semibold">Pixel Dimensions</span>
              <!-- Lock Aspect Ratio Toggle -->
              <button
                type="button"
                id="btn-lock-aspect"
                class="px-2.5 py-1 rounded text-xs font-mono flex items-center gap-1.5 transition-colors bg-[#171717] text-white"
                data-locked="true"
                title="When locked, changing width or height recalculates the other according to the ratio above"
              >
                <span id="lock-icon">🔒</span>
                <span id="lock-text">Aspect Locked</span>
              </button>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="input-pixel-w" class="block text-[11px] font-mono text-[#8f8f8f] mb-1">Width (px)</label>
                <input
                  type="number"
                  id="input-pixel-w"
                  value={defaultWidth}
                  min="1"
                  class="w-full h-10 px-3 rounded-md bg-white border border-[#ebebeb] focus:border-[#171717] focus:outline-none text-sm font-mono text-[#171717]"
                />
              </div>
              <div>
                <label for="input-pixel-h" class="block text-[11px] font-mono text-[#8f8f8f] mb-1">Height (px)</label>
                <input
                  type="number"
                  id="input-pixel-h"
                  value={defaultHeight}
                  min="1"
                  class="w-full h-10 px-3 rounded-md bg-white border border-[#ebebeb] focus:border-[#171717] focus:outline-none text-sm font-mono text-[#171717]"
                />
              </div>
            </div>

            <!-- Swap Dimensions Button -->
            <div class="flex items-center justify-end pt-1">
              <button
                type="button"
                id="btn-swap-dims"
                class="px-2.5 py-1 text-xs font-mono rounded bg-white border border-[#ebebeb] hover:border-[#171717] text-[#171717] transition-colors flex items-center gap-1 cursor-pointer"
              >
                <span>Swap Dimensions ⇄</span>
              </button>
            </div>
          </div>
        </div>

        <!-- MODE 3: PROPORTIONAL RESIZE -->
        <div id="panel-resize" class="tool-panel space-y-5 hidden">
          <div>
            <label class="block text-xs font-mono uppercase tracking-wider text-[#171717] font-semibold mb-2">
              Original Base Dimensions
            </label>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <span class="block text-[11px] font-mono text-[#8f8f8f] mb-1">Base Width (px)</span>
                <input
                  type="number"
                  id="resize-orig-w"
                  value={defaultWidth}
                  class="w-full h-10 px-3 rounded-md bg-white border border-[#ebebeb] text-sm font-mono text-[#171717]"
                />
              </div>
              <div>
                <span class="block text-[11px] font-mono text-[#8f8f8f] mb-1">Base Height (px)</span>
                <input
                  type="number"
                  id="resize-orig-h"
                  value={defaultHeight}
                  class="w-full h-10 px-3 rounded-md bg-white border border-[#ebebeb] text-sm font-mono text-[#171717]"
                />
              </div>
            </div>
          </div>

          <!-- Scale Presets -->
          <div class="p-4 rounded-lg bg-[#fafafa] border border-[#ebebeb] space-y-3">
            <span class="text-xs font-mono uppercase text-[#171717] font-semibold block">Scale Multiplier</span>
            <div class="flex flex-wrap gap-1.5">
              <button type="button" data-scale="25" class="scale-btn px-2.5 py-1 text-xs font-mono rounded border border-[#ebebeb] bg-white text-[#171717] hover:border-[#171717]">25% (0.25x)</button>
              <button type="button" data-scale="50" class="scale-btn px-2.5 py-1 text-xs font-mono rounded border border-[#171717] bg-[#171717] text-white">50% (0.5x)</button>
              <button type="button" data-scale="75" class="scale-btn px-2.5 py-1 text-xs font-mono rounded border border-[#ebebeb] bg-white text-[#171717] hover:border-[#171717]">75% (0.75x)</button>
              <button type="button" data-scale="150" class="scale-btn px-2.5 py-1 text-xs font-mono rounded border border-[#ebebeb] bg-white text-[#171717] hover:border-[#171717]">150% (1.5x)</button>
              <button type="button" data-scale="200" class="scale-btn px-2.5 py-1 text-xs font-mono rounded border border-[#ebebeb] bg-white text-[#171717] hover:border-[#171717]">200% (2x)</button>
              <button type="button" data-scale="400" class="scale-btn px-2.5 py-1 text-xs font-mono rounded border border-[#ebebeb] bg-white text-[#171717] hover:border-[#171717]">400% (4K/8K)</button>
            </div>

            <!-- Percentage Slider -->
            <div class="pt-2">
              <div class="flex items-center justify-between text-xs font-mono text-[#8f8f8f] mb-1">
                <span>Custom Percentage:</span>
                <span id="scale-slider-value" class="font-semibold text-[#171717]">50%</span>
              </div>
              <input
                type="range"
                id="resize-slider"
                min="10"
                max="300"
                value="50"
                class="w-full accent-[#171717] cursor-pointer"
              />
            </div>
          </div>

          <!-- Resized Target Specs -->
          <div class="bg-[#fafafa] rounded-lg border border-[#ebebeb] p-4 space-y-2">
            <span class="text-xs font-mono font-medium text-[#8f8f8f] uppercase">Resulting Resized Dimensions</span>
            <div class="grid grid-cols-2 gap-3 pt-1">
              <div class="bg-white p-3 rounded border border-[#ebebeb]">
                <div class="text-[11px] text-[#8f8f8f] font-mono">New Dimensions</div>
                <div id="resized-dims" class="text-base font-semibold text-[#171717] font-mono mt-0.5">960 × 540</div>
              </div>
              <div class="bg-white p-3 rounded border border-[#ebebeb]">
                <div class="text-[11px] text-[#8f8f8f] font-mono">New Megapixels</div>
                <div id="resized-mp" class="text-base font-semibold text-[#171717] font-mono mt-0.5">0.5 MP</div>
              </div>
            </div>
          </div>
        </div>

        <!-- MODE 4: CROP & FRAMING CALCULATOR -->
        <div id="panel-crop" class="tool-panel space-y-5 hidden">
          <div>
            <label class="block text-xs font-mono uppercase tracking-wider text-[#171717] font-semibold mb-2">
              Source Dimensions
            </label>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <span class="block text-[11px] font-mono text-[#8f8f8f] mb-1">Current Width (px)</span>
                <input
                  type="number"
                  id="crop-src-w"
                  value={defaultWidth}
                  class="w-full h-10 px-3 rounded-md bg-white border border-[#ebebeb] text-sm font-mono text-[#171717]"
                />
              </div>
              <div>
                <span class="block text-[11px] font-mono text-[#8f8f8f] mb-1">Current Height (px)</span>
                <input
                  type="number"
                  id="crop-src-h"
                  value={defaultHeight}
                  class="w-full h-10 px-3 rounded-md bg-white border border-[#ebebeb] text-sm font-mono text-[#171717]"
                />
              </div>
            </div>
          </div>

          <!-- Target Crop Ratio -->
          <div class="p-4 rounded-lg bg-[#fafafa] border border-[#ebebeb] space-y-3">
            <span class="text-xs font-mono uppercase text-[#171717] font-semibold block">Target Aspect Ratio</span>
            <div class="flex flex-wrap gap-1.5">
              <button type="button" data-crop-target="1:1" class="crop-preset-btn px-2.5 py-1 text-xs font-mono rounded border border-[#171717] bg-[#171717] text-white">1:1 Square</button>
