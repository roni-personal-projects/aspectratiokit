<!-- Client-side script handling all math and interactive behaviors -->
<script>
  import { analyzeDimensions, calculateCrop, calculateHeight, calculateWidth, COMMON_RATIOS } from '../lib/aspect-ratio';

  // State
  let currentWidth = 1920;
  let currentHeight = 1080;
  let ratioW = 16;
  let ratioH = 9;
  let isAspectLocked = true;
  let currentTool = 'finder';
  let isGridVisible = false;
  let isDarkStage = false;
  let uploadedImageObj: HTMLImageElement | null = null;
  let uploadedFileName = 'aspect-ratio-kit-export';

  // Elements
  const toolTabs = document.querySelectorAll('.tool-tab');
  const toolPanels = document.querySelectorAll('.tool-panel');

  // Finder elements
  const dropzone = document.getElementById('image-dropzone');
  const fileInput = document.getElementById('image-file-input') as HTMLInputElement | null;
  const detectedDims = document.getElementById('detected-dims');
  const detectedRatio = document.getElementById('detected-ratio');
  const detectedDecimal = document.getElementById('detected-decimal');
  const detectedMp = document.getElementById('detected-mp');
  const detectedBadge = document.getElementById('detected-orientation-badge');
  const sendToCropBtn = document.getElementById('send-to-crop-btn');
  const sendToResizeBtn = document.getElementById('send-to-resize-btn');
  const sampleBtns = document.querySelectorAll('.sample-btn');

  // Calculator elements
  const inputRatioW = document.getElementById('input-ratio-w') as HTMLInputElement | null;
  const inputRatioH = document.getElementById('input-ratio-h') as HTMLInputElement | null;
  const inputPixelW = document.getElementById('input-pixel-w') as HTMLInputElement | null;
  const inputPixelH = document.getElementById('input-pixel-h') as HTMLInputElement | null;
  const btnLockAspect = document.getElementById('btn-lock-aspect');
  const lockIcon = document.getElementById('lock-icon');
  const lockText = document.getElementById('lock-text');
  const btnSwapDims = document.getElementById('btn-swap-dims');
  const calcPresetBtns = document.querySelectorAll('.calc-preset-btn');

  // Resize elements
  const resizeOrigW = document.getElementById('resize-orig-w') as HTMLInputElement | null;
  const resizeOrigH = document.getElementById('resize-orig-h') as HTMLInputElement | null;
  const resizeSlider = document.getElementById('resize-slider') as HTMLInputElement | null;
  const scaleSliderValue = document.getElementById('scale-slider-value');
  const resizedDims = document.getElementById('resized-dims');
  const resizedMp = document.getElementById('resized-mp');
  const scaleBtns = document.querySelectorAll('.scale-btn');

  // Crop elements
  const cropSrcW = document.getElementById('crop-src-w') as HTMLInputElement | null;
  const cropSrcH = document.getElementById('crop-src-h') as HTMLInputElement | null;
  const cropTargetW = document.getElementById('crop-target-w') as HTMLInputElement | null;
  const cropTargetH = document.getElementById('crop-target-h') as HTMLInputElement | null;
  const cropOutputDims = document.getElementById('crop-output-dims');
  const cropOutputTrim = document.getElementById('crop-output-trim');
  const cropOutputPercent = document.getElementById('crop-output-percent');
  const cropAxisTag = document.getElementById('crop-axis-tag');
  const cropPresetBtns = document.querySelectorAll('.crop-preset-btn');
  const cropOverlayLeft = document.getElementById('crop-overlay-left');
  const cropOverlayRight = document.getElementById('crop-overlay-right');
  const cropOverlayTop = document.getElementById('crop-overlay-top');
  const cropOverlayBottom = document.getElementById('crop-overlay-bottom');

  // Solver elements
  const solverWidthInput = document.getElementById('solver-width-input') as HTMLInputElement | null;
  const solverHeightInput = document.getElementById('solver-height-input') as HTMLInputElement | null;
  const solverCalcHeight = document.getElementById('solver-calc-height');
  const solverCalcWidth = document.getElementById('solver-calc-width');
  const solverPresetBtns = document.querySelectorAll('.solver-preset-btn');
  let solverRatioW = 16;
  let solverRatioH = 9;

  // Visualizer elements
  const visualizerStage = document.getElementById('visualizer-stage');
  const shapeBox = document.getElementById('shape-box');
  const thirdsGrid = document.getElementById('thirds-grid');
  const visRatioLabel = document.getElementById('vis-ratio-label');
  const visDecimalLabel = document.getElementById('vis-decimal-label');
  const visDimTag = document.getElementById('vis-dim-tag');
  const visOrientationText = document.getElementById('vis-orientation-text');
  const btnToggleGrid = document.getElementById('btn-toggle-grid');
  const btnToggleTheme = document.getElementById('btn-toggle-theme');
  const btnDownloadImage = document.getElementById('btn-download-image');

  // Copy elements
  const copyBtns = document.querySelectorAll('.copy-btn');
  const copyCodeCss = document.getElementById('copy-code-css');
  const copyCodeTailwind = document.getElementById('copy-code-tailwind');
  const copyCodeDims = document.getElementById('copy-code-dims');
  const copyCodeHtml = document.getElementById('copy-code-html');
  const copyToast = document.getElementById('copy-toast');

  // Initialize tool tab switching
  function switchTab(tabId: string) {
    currentTool = tabId;
    toolTabs.forEach((btn) => {
      const match = (btn as HTMLElement).dataset.toolTab === tabId;
      if (match) {
        btn.classList.remove('text-[#4d4d4d]');
        btn.classList.add('bg-[#ffffff]', 'text-[#171717]', 'shadow-xs', 'font-semibold');
      } else {
        btn.classList.add('text-[#4d4d4d]');
        btn.classList.remove('bg-[#ffffff]', 'text-[#171717]', 'shadow-xs', 'font-semibold');
      }
    });

    toolPanels.forEach((panel) => {
      if (panel.id === `panel-${tabId}`) {
        panel.classList.remove('hidden');
      } else {
        panel.classList.add('hidden');
      }
    });

    // Update crop overlays visibility
    if (tabId === 'crop') {
      updateCropDisplay();
    } else {
      hideCropOverlays();
    }
  }

  toolTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = (tab as HTMLElement).dataset.toolTab;
      if (target) switchTab(target);
    });
  });

  // Master update visualizer & code snippets
  function updateAll(w: number, h: number, rW?: number, rH?: number) {
    currentWidth = Math.max(1, Math.round(w));
    currentHeight = Math.max(1, Math.round(h));

    const analysis = analyzeDimensions(currentWidth, currentHeight);
    if (rW !== undefined && rH !== undefined) {
      ratioW = rW;
      ratioH = rH;
    } else {
      ratioW = analysis.ratioW;
      ratioH = analysis.ratioH;
    }

    // Update Finder view
    if (detectedDims) detectedDims.textContent = `${currentWidth} × ${currentHeight}`;
    if (detectedRatio) detectedRatio.textContent = analysis.formattedRatio;
    if (detectedDecimal) detectedDecimal.textContent = analysis.decimalString;
    if (detectedMp) detectedMp.textContent = analysis.megapixels;
    if (detectedBadge) {
      const orientationMap = {
        landscape: 'Landscape 🖥️',
        portrait: 'Portrait 📱',
        square: 'Square ⏹️',
      };
      detectedBadge.textContent = orientationMap[analysis.orientation];
    }

    // Update Calculator inputs
    if (inputPixelW && document.activeElement !== inputPixelW) inputPixelW.value = String(currentWidth);
    if (inputPixelH && document.activeElement !== inputPixelH) inputPixelH.value = String(currentHeight);
    if (inputRatioW && document.activeElement !== inputRatioW) inputRatioW.value = String(ratioW);
    if (inputRatioH && document.activeElement !== inputRatioH) inputRatioH.value = String(ratioH);

    // Update Resizer base inputs
    if (resizeOrigW) resizeOrigW.value = String(currentWidth);
    if (resizeOrigH) resizeOrigH.value = String(currentHeight);
    updateResizeCalculation();

    // Update Crop source inputs
    if (cropSrcW) cropSrcW.value = String(currentWidth);
    if (cropSrcH) cropSrcH.value = String(currentHeight);
    updateCropDisplay();

    // Update Quick Solver
    updateSolverDisplay();

    // Update Proportional Shape Visualizer
    updateShapeVisualizer(currentWidth, currentHeight, analysis);

    // Update Code Snippets
    updateCodeSnippets(currentWidth, currentHeight, ratioW, ratioH);
  }

  function updateShapeVisualizer(w: number, h: number, analysis: any) {
    if (!shapeBox || !visualizerStage) return;

    const stageWidth = visualizerStage.clientWidth - 32;
    const stageHeight = visualizerStage.clientHeight - 32;

    const ratio = w / h;
    let targetBoxW = stageWidth;
    let targetBoxH = targetBoxW / ratio;

    if (targetBoxH > stageHeight) {
      targetBoxH = stageHeight;
      targetBoxW = targetBoxH * ratio;
    }

    shapeBox.style.width = `${Math.round(targetBoxW)}px`;
    shapeBox.style.height = `${Math.round(targetBoxH)}px`;

    if (visRatioLabel) visRatioLabel.textContent = `${ratioW}:${ratioH}`;
    if (visDecimalLabel) visDecimalLabel.textContent = analysis.decimalString;
    if (visDimTag) visDimTag.textContent = `${w} × ${h}`;
    if (visOrientationText) {
      visOrientationText.textContent = `${analysis.orientation.toUpperCase()} (${analysis.decimalString})`;
    }
  }

  function updateCodeSnippets(w: number, h: number, rW: number, rH: number) {
    if (copyCodeCss) copyCodeCss.textContent = `aspect-ratio: ${rW}/${rH};`;
    if (copyCodeDims) copyCodeDims.textContent = `${w} × ${h} px`;
    if (copyCodeHtml) copyCodeHtml.textContent = `width="${w}" height="${h}"`;

    let twClass = `aspect-[${rW}/${rH}]`;
    if (rW === 16 && rH === 9) twClass = 'aspect-video';
    else if (rW === 1 && rH === 1) twClass = 'aspect-square';
    else if (rW === 9 && rH === 16) twClass = 'aspect-9/16';
    else if (rW === 4 && rH === 3) twClass = 'aspect-4/3';
    if (copyCodeTailwind) copyCodeTailwind.textContent = twClass;
  }

  // Handle Drag & Drop / File Upload
  if (dropzone && fileInput) {
    dropzone.addEventListener('click', () => fileInput.click());

    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('border-[#171717]', 'bg-[#f2f2f2]');
    });

    dropzone.addEventListener('dragleave', () => {
      dropzone.classList.remove('border-[#171717]', 'bg-[#f2f2f2]');
    });

    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-[#171717]', 'bg-[#f2f2f2]');
      if (e.dataTransfer && e.dataTransfer.files.length > 0) {
        processImageFile(e.dataTransfer.files[0]);
      }
    });

    fileInput.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.files && target.files.length > 0) {
        processImageFile(target.files[0]);
      }
    });
  }

  function processImageFile(file: File) {
    if (!file.type.startsWith('image/')) {
      alert('Please upload an image file (PNG, JPG, WebP, etc.)');
      return;
    }

    uploadedFileName = file.name.replace(/\.[^/.]+$/, '');
    const reader = new FileReader();
    reader.onload = (event) => {
      const img = new Image();
      img.onload = () => {
        uploadedImageObj = img;
        updateAll(img.naturalWidth, img.naturalHeight);
      };
      img.src = event.target?.result as string;
    };
    reader.readAsDataURL(file);
  }

  // Sample Buttons
  sampleBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const size = (btn as HTMLElement).dataset.sampleSize;
      if (size) {
        const [w, h] = size.split('x').map(Number);
        updateAll(w, h);
      }
    });
  });

  // Send to tools buttons
  if (sendToCropBtn) {
    sendToCropBtn.addEventListener('click', () => switchTab('crop'));
  }
  if (sendToResizeBtn) {
    sendToResizeBtn.addEventListener('click', () => switchTab('resize'));
  }

  // Calculator Lock Toggle
  if (btnLockAspect) {
    btnLockAspect.addEventListener('click', () => {
      isAspectLocked = !isAspectLocked;
      btnLockAspect.dataset.locked = String(isAspectLocked);
      if (isAspectLocked) {
        btnLockAspect.classList.remove('bg-white', 'text-[#171717]', 'border');
        btnLockAspect.classList.add('bg-[#171717]', 'text-white');
        if (lockIcon) lockIcon.textContent = '🔒';
        if (lockText) lockText.textContent = 'Aspect Locked';
      } else {
        btnLockAspect.classList.remove('bg-[#171717]', 'text-white');
        btnLockAspect.classList.add('bg-white', 'text-[#171717]', 'border', 'border-[#ebebeb]');
        if (lockIcon) lockIcon.textContent = '🔓';
        if (lockText) lockText.textContent = 'Unlocked';
      }
    });
  }

  // Calculator inputs event listeners
  if (inputPixelW) {
    inputPixelW.addEventListener('input', () => {
      const w = Number(inputPixelW.value) || 1;
      if (isAspectLocked && ratioW && ratioH) {
        const h = calculateHeight(w, ratioW, ratioH);
        updateAll(w, h, ratioW, ratioH);
      } else {
        updateAll(w, currentHeight);
      }
    });
  }

  if (inputPixelH) {
    inputPixelH.addEventListener('input', () => {
      const h = Number(inputPixelH.value) || 1;
      if (isAspectLocked && ratioW && ratioH) {
        const w = calculateWidth(h, ratioW, ratioH);
        updateAll(w, h, ratioW, ratioH);
      } else {
        updateAll(currentWidth, h);
      }
    });
  }

  if (inputRatioW || inputRatioH) {
    const handleRatioChange = () => {
      const rW = Number(inputRatioW?.value) || 1;
      const rH = Number(inputRatioH?.value) || 1;
      ratioW = rW;
      ratioH = rH;
      if (isAspectLocked) {
        const newH = calculateHeight(currentWidth, ratioW, ratioH);
        updateAll(currentWidth, newH, ratioW, ratioH);
      } else {
        updateAll(currentWidth, currentHeight, ratioW, ratioH);
      }
    };
    inputRatioW?.addEventListener('input', handleRatioChange);
    inputRatioH?.addEventListener('input', handleRatioChange);
  }

  // Swap Dimensions
  if (btnSwapDims) {
    btnSwapDims.addEventListener('click', () => {
      updateAll(currentHeight, currentWidth, ratioH, ratioW);
    });
  }

  // Preset Buttons
  calcPresetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      calcPresetBtns.forEach((b) => {
        b.classList.remove('bg-[#171717]', 'text-white', 'border-[#171717]');
        b.classList.add('bg-white', 'text-[#171717]', 'border-[#ebebeb]');
      });
      btn.classList.remove('bg-white', 'text-[#171717]', 'border-[#ebebeb]');
      btn.classList.add('bg-[#171717]', 'text-white', 'border-[#171717]');

      const presetStr = (btn as HTMLElement).dataset.preset;
      if (presetStr) {
        const [pW, pH] = presetStr.split(':').map(Number);
        ratioW = pW;
        ratioH = pH;
        const newH = calculateHeight(currentWidth, ratioW, ratioH);
        updateAll(currentWidth, newH, ratioW, ratioH);
      }
    });
  });

  // Resizer Logic
  function updateResizeCalculation() {
    const origW = Number(resizeOrigW?.value) || currentWidth;
    const origH = Number(resizeOrigH?.value) || currentHeight;
    const percent = Number(resizeSlider?.value) || 50;

    const factor = percent / 100;
    const newW = Math.max(1, Math.round(origW * factor));
    const newH = Math.max(1, Math.round(origH * factor));
    const mp = ((newW * newH) / 1_000_000).toFixed(1) + ' MP';

    if (scaleSliderValue) scaleSliderValue.textContent = `${percent}% (${factor.toFixed(2)}x)`;
    if (resizedDims) resizedDims.textContent = `${newW} × ${newH}`;
    if (resizedMp) resizedMp.textContent = mp;
  }

  if (resizeSlider) {
    resizeSlider.addEventListener('input', () => {
      updateResizeCalculation();
    });
  }

  scaleBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      scaleBtns.forEach((b) => {
        b.classList.remove('bg-[#171717]', 'text-white', 'border-[#171717]');
        b.classList.add('bg-white', 'text-[#171717]', 'border-[#ebebeb]');
      });
      btn.classList.remove('bg-white', 'text-[#171717]', 'border-[#ebebeb]');
      btn.classList.add('bg-[#171717]', 'text-white', 'border-[#171717]');

      const s = Number((btn as HTMLElement).dataset.scale);
      if (resizeSlider) {
        resizeSlider.value = String(s);
        updateResizeCalculation();
      }
    });
  });

  // Crop Logic
  function updateCropDisplay() {
    const srcW = Number(cropSrcW?.value) || currentWidth;
    const srcH = Number(cropSrcH?.value) || currentHeight;
    const targetW = Number(cropTargetW?.value) || 1;
    const targetH = Number(cropTargetH?.value) || 1;

    const crop = calculateCrop(srcW, srcH, targetW, targetH);

    if (cropOutputDims) cropOutputDims.textContent = `${crop.cropWidth} × ${crop.cropHeight}`;
    if (cropOutputTrim) {
      if (crop.cropAxis === 'horizontal') {
        cropOutputTrim.textContent = `${crop.trimWidth} px (${crop.trimLeft}px/side)`;
      } else if (crop.cropAxis === 'vertical') {
        cropOutputTrim.textContent = `${crop.trimHeight} px (${crop.trimTop}px top/bot)`;
      } else {
        cropOutputTrim.textContent = `0 px (Exact match)`;
      }
    }
    if (cropOutputPercent) cropOutputPercent.textContent = `${crop.percentRetained}%`;
    if (cropAxisTag) {
      if (crop.cropAxis === 'horizontal') cropAxisTag.textContent = 'Horizontal Crop (Trim Left & Right)';
      else if (crop.cropAxis === 'vertical') cropAxisTag.textContent = 'Vertical Crop (Trim Top & Bottom)';
      else cropAxisTag.textContent = 'No Crop Needed (100% Match)';
    }

    // Update Visual Crop Overlays on Shape Box
    if (currentTool === 'crop' && shapeBox) {
      if (crop.cropAxis === 'horizontal') {
        const trimRatio = crop.trimLeft / srcW;
        const trimWidthPx = Math.round(shapeBox.clientWidth * trimRatio);
        if (cropOverlayLeft) {
          cropOverlayLeft.style.width = `${trimWidthPx}px`;
          cropOverlayLeft.classList.remove('hidden');
        }
        if (cropOverlayRight) {
          cropOverlayRight.style.width = `${trimWidthPx}px`;
          cropOverlayRight.classList.remove('hidden');
        }
        cropOverlayTop?.classList.add('hidden');
        cropOverlayBottom?.classList.add('hidden');
      } else if (crop.cropAxis === 'vertical') {
        const trimRatio = crop.trimTop / srcH;
        const trimHeightPx = Math.round(shapeBox.clientHeight * trimRatio);
        if (cropOverlayTop) {
          cropOverlayTop.style.height = `${trimHeightPx}px`;
          cropOverlayTop.classList.remove('hidden');
        }
        if (cropOverlayBottom) {
          cropOverlayBottom.style.height = `${trimHeightPx}px`;
          cropOverlayBottom.classList.remove('hidden');
        }
        cropOverlayLeft?.classList.add('hidden');
        cropOverlayRight?.classList.add('hidden');
      } else {
        hideCropOverlays();
      }
    }
  }

  function hideCropOverlays() {
    cropOverlayLeft?.classList.add('hidden');
    cropOverlayRight?.classList.add('hidden');
    cropOverlayTop?.classList.add('hidden');
    cropOverlayBottom?.classList.add('hidden');
  }

  cropPresetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      cropPresetBtns.forEach((b) => {
        b.classList.remove('bg-[#171717]', 'text-white', 'border-[#171717]');
        b.classList.add('bg-white', 'text-[#171717]', 'border-[#ebebeb]');
      });
      btn.classList.remove('bg-white', 'text-[#171717]', 'border-[#ebebeb]');
      btn.classList.add('bg-[#171717]', 'text-white', 'border-[#171717]');

      const target = (btn as HTMLElement).dataset.cropTarget;
      if (target) {
        const [cW, cH] = target.split(':').map(Number);
        if (cropTargetW) cropTargetW.value = String(cW);
        if (cropTargetH) cropTargetH.value = String(cH);
        updateCropDisplay();
      }
    });
  });

  cropTargetW?.addEventListener('input', updateCropDisplay);
  cropTargetH?.addEventListener('input', updateCropDisplay);
  cropSrcW?.addEventListener('input', updateCropDisplay);
  cropSrcH?.addEventListener('input', updateCropDisplay);

  // Quick Solver Logic
  function updateSolverDisplay() {
    const w = Number(solverWidthInput?.value) || 1920;
    const h = Number(solverHeightInput?.value) || 1080;

    const calcH = calculateHeight(w, solverRatioW, solverRatioH);
    const calcW = calculateWidth(h, solverRatioW, solverRatioH);

    if (solverCalcHeight) solverCalcHeight.textContent = `${calcH} px`;
    if (solverCalcWidth) solverCalcWidth.textContent = `${calcW} px`;
  }

  solverWidthInput?.addEventListener('input', updateSolverDisplay);
  solverHeightInput?.addEventListener('input', updateSolverDisplay);

  solverPresetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      solverPresetBtns.forEach((b) => {
        b.classList.remove('bg-[#171717]', 'text-white', 'border-[#171717]');
        b.classList.add('bg-white', 'text-[#171717]', 'border-[#ebebeb]');
      });
      btn.classList.remove('bg-white', 'text-[#171717]', 'border-[#ebebeb]');
      btn.classList.add('bg-[#171717]', 'text-white', 'border-[#171717]');

      const p = (btn as HTMLElement).dataset.solverPreset;
      if (p) {
        const [sW, sH] = p.split(':').map(Number);
        solverRatioW = sW;
        solverRatioH = sH;
        updateSolverDisplay();
      }
    });
  });

  // Visualizer Toggles (Grid & Theme)
  if (btnToggleGrid) {
    btnToggleGrid.addEventListener('click', () => {
      isGridVisible = !isGridVisible;
      if (isGridVisible) {
        thirdsGrid?.classList.remove('hidden');
        btnToggleGrid.classList.add('bg-[#171717]', 'text-white');
      } else {
        thirdsGrid?.classList.add('hidden');
        btnToggleGrid.classList.remove('bg-[#171717]', 'text-white');
      }
    });
  }

  if (btnToggleTheme) {
    btnToggleTheme.addEventListener('click', () => {
      isDarkStage = !isDarkStage;
      if (isDarkStage) {
        visualizerStage?.classList.remove('bg-[#ffffff]');
        visualizerStage?.classList.add('bg-[#171717]');
        shapeBox?.classList.remove('border-[#171717]', 'bg-[#171717]/5');
        shapeBox?.classList.add('border-white', 'bg-white/10');
      } else {
        visualizerStage?.classList.remove('bg-[#171717]');
        visualizerStage?.classList.add('bg-[#ffffff]');
        shapeBox?.classList.remove('border-white', 'bg-white/10');
        shapeBox?.classList.add('border-[#171717]', 'bg-[#171717]/5');
      }
    });
  }

  // Client-Side Canvas Image Export / Download
  if (btnDownloadImage) {
    btnDownloadImage.addEventListener('click', () => {
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      if (currentTool === 'crop') {
        const targetW = Number(cropTargetW?.value) || 1;
        const targetH = Number(cropTargetH?.value) || 1;
        const crop = calculateCrop(currentWidth, currentHeight, targetW, targetH);

        canvas.width = crop.cropWidth;
        canvas.height = crop.cropHeight;

        if (uploadedImageObj) {
          ctx.drawImage(
            uploadedImageObj,
            crop.trimLeft,
            crop.trimTop,
            crop.cropWidth,
            crop.cropHeight,
            0,
            0,
            crop.cropWidth,
            crop.cropHeight
          );
        } else {
          // Draw clean mock canvas placeholder with dimensions
          ctx.fillStyle = '#171717';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.fillStyle = '#ffffff';
          ctx.font = 'bold 36px monospace';
          ctx.textAlign = 'center';
          ctx.fillText(`AspectRatioKit: ${crop.cropWidth} × ${crop.cropHeight}`, canvas.width / 2, canvas.height / 2);
        }
      } else if (currentTool === 'resize') {
        const percent = Number(resizeSlider?.value) || 100;
        const factor = percent / 100;
        const newW = Math.max(1, Math.round(currentWidth * factor));
        const newH = Math.max(1, Math.round(currentHeight * factor));

        canvas.width = newW;
        canvas.height = newH;

        if (uploadedImageObj) {
          ctx.drawImage(uploadedImageObj, 0, 0, newW, newH);
        } else {
          ctx.fillStyle = '#171717';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.fillStyle = '#ffffff';
          ctx.font = 'bold 36px monospace';
          ctx.textAlign = 'center';
          ctx.fillText(`${newW} × ${newH}`, canvas.width / 2, canvas.height / 2);
        }
      } else {
        canvas.width = currentWidth;
        canvas.height = currentHeight;
        if (uploadedImageObj) {
          ctx.drawImage(uploadedImageObj, 0, 0, currentWidth, currentHeight);
        } else {
          ctx.fillStyle = '#171717';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.fillStyle = '#ffffff';
          ctx.font = 'bold 36px monospace';
          ctx.textAlign = 'center';
          ctx.fillText(`${currentWidth} × ${currentHeight}`, canvas.width / 2, canvas.height / 2);
        }
      }

      const link = document.createElement('a');
      link.download = `${uploadedFileName}-${canvas.width}x${canvas.height}.png`;
      link.href = canvas.toDataURL('image/png');
      link.click();
    });
  }

  // Copy Buttons
  copyBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const copyType = (btn as HTMLElement).dataset.copyType;
      let text = '';
      if (copyType === 'css') text = `aspect-ratio: ${ratioW} / ${ratioH};`;
      else if (copyType === 'tailwind') text = copyCodeTailwind?.textContent || '';
      else if (copyType === 'dims') text = `${currentWidth} × ${currentHeight}`;
      else if (copyType === 'html') text = `width="${currentWidth}" height="${currentHeight}"`;

      if (text) {
        navigator.clipboard.writeText(text).then(() => {
          if (copyToast) {
            copyToast.classList.remove('opacity-0');
            setTimeout(() => copyToast.classList.add('opacity-0'), 2000);
          }
        });
      }
    });
  });

  // Handle Initial Props & window resize for responsive visualizer
  window.addEventListener('resize', () => {
    const analysis = analyzeDimensions(currentWidth, currentHeight);
    updateShapeVisualizer(currentWidth, currentHeight, analysis);
    if (currentTool === 'crop') updateCropDisplay();
  });

  // Initial Boot
  updateAll(currentWidth, currentHeight, ratioW, ratioH);
</script>
