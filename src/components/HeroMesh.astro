---
interface Props {
  eyebrow?: string;
  title?: string;
  highlight?: string;
  description?: string;
}

const {
  eyebrow = 'FAST • CLIENT-SIDE • 100% PRIVACY FIRST',
  title = 'The Precision Image',
  highlight = 'Aspect Ratio Toolkit',
  description = 'Calculate aspect ratios, detect image dimensions, resize proportionally, and solve framing crops directly in your browser. No ads, no file uploads, pure mathematical precision.',
} = Astro.props;
---

<section class="relative overflow-hidden pt-12 pb-16 md:pt-20 md:pb-24 hero-mesh-bg border-b border-[#ebebeb] dark:border-[#262626] transition-colors duration-150">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <!-- Technical Eyebrow (Geist Mono) -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#ffffff]/80 dark:bg-[#141414]/80 border border-[#ebebeb] dark:border-[#262626] text-[11px] font-mono tracking-wider uppercase text-[#171717] dark:text-[#ededed] mb-6 shadow-[0_1px_2px_rgba(0,0,0,0.03)] backdrop-blur-xs">
      <span class="w-1.5 h-1.5 rounded-full bg-[#0070f3]"></span>
      <span>{eyebrow}</span>
    </div>

    <!-- Display Headline (Geist Sans with tight tracking) -->
    <h1 class="text-3xl sm:text-5xl md:text-6xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-white leading-[1.08] max-w-4xl mx-auto">
      {title} <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#007cf0] via-[#7928ca] to-[#ff0080]">{highlight}</span>
    </h1>

    <!-- Subtitle / Body Copy -->
    <p class="mt-4 sm:mt-5 text-sm sm:text-lg text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed font-sans">
      {description}
    </p>

    <!-- Marketing CTAs (Pill-shaped as defined in DESIGN.md) -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="#workbench"
        class="w-full sm:w-auto px-5 py-2.5 rounded-full bg-[#171717] dark:bg-white text-[#ffffff] dark:text-[#171717] text-sm font-medium hover:bg-[#333333] dark:hover:bg-[#ededed] transition-all shadow-sm flex items-center justify-center gap-2"
      >
        <span>Start Calculating</span>
        <span>→</span>
      </a>

      <a
        href="/image-aspect-ratio"
        class="w-full sm:w-auto px-5 py-2.5 rounded-full bg-[#ffffff] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#262626] text-[#171717] dark:text-white text-sm font-medium hover:border-[#171717] dark:hover:border-white transition-all shadow-xs"
      >
        Browse Ratio Library
      </a>
    </div>

    <!-- Key Metrics Strip -->
    <div class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 max-w-3xl mx-auto pt-6 border-t border-[#ebebeb]/60 dark:border-[#262626]/60 text-left">
      <div class="bg-[#ffffff]/60 dark:bg-[#141414]/60 p-3 rounded-lg border border-[#ebebeb]/80 dark:border-[#262626]/80 backdrop-blur-xs">
        <div class="text-[11px] font-mono text-[#8f8f8f] dark:text-[#737373] uppercase">Privacy</div>
        <div class="text-xs sm:text-sm font-semibold text-[#171717] dark:text-[#ededed] font-mono mt-0.5">100% In-Browser</div>
      </div>
      <div class="bg-[#ffffff]/60 dark:bg-[#141414]/60 p-3 rounded-lg border border-[#ebebeb]/80 dark:border-[#262626]/80 backdrop-blur-xs">
        <div class="text-[11px] font-mono text-[#8f8f8f] dark:text-[#737373] uppercase">Input Format</div>
        <div class="text-xs sm:text-sm font-semibold text-[#171717] dark:text-[#ededed] font-mono mt-0.5">Image &amp; Dimensions</div>
      </div>
      <div class="bg-[#ffffff]/60 dark:bg-[#141414]/60 p-3 rounded-lg border border-[#ebebeb]/80 dark:border-[#262626]/80 backdrop-blur-xs">
        <div class="text-[11px] font-mono text-[#8f8f8f] dark:text-[#737373] uppercase">Core Tools</div>
        <div class="text-xs sm:text-sm font-semibold text-[#171717] dark:text-[#ededed] font-mono mt-0.5">5 Unified Solvers</div>
      </div>
      <div class="bg-[#ffffff]/60 dark:bg-[#141414]/60 p-3 rounded-lg border border-[#ebebeb]/80 dark:border-[#262626]/80 backdrop-blur-xs">
        <div class="text-[11px] font-mono text-[#8f8f8f] dark:text-[#737373] uppercase">Ad Clutter</div>
        <div class="text-xs sm:text-sm font-semibold text-[#171717] dark:text-[#ededed] font-mono mt-0.5">Zero Ads</div>
      </div>
    </div>
  </div>
</section>
