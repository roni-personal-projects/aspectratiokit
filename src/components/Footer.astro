---
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#fafafa] dark:bg-[#0a0a0a] border-t border-[#ebebeb] dark:border-[#262626] mt-24 transition-colors duration-150">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-10">
      <!-- Brand & Mission -->
      <div class="md:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-2">
          <div class="w-6 h-6 rounded-md bg-[#171717] dark:bg-white text-white dark:text-[#171717] flex items-center justify-center font-mono font-bold text-[10px]">
            AR
          </div>
          <span class="font-semibold text-base tracking-tight text-[#171717] dark:text-white">
            AspectRatioKit<span class="text-[#8f8f8f] font-normal">.pages.dev</span>
          </span>
        </a>
        <p class="text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed max-w-sm">
          A free, privacy-first image and dimension aspect ratio toolkit. Calculate ratios, resize proportionally, and solve framing crops in your browser with zero server uploads.
        </p>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-[#ffffff] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#262626] text-xs font-mono text-[#4d4d4d] dark:text-[#a1a1a1]">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Zero-upload privacy: processed entirely in your browser</span>
        </div>
      </div>

      <!-- Ratio Calculators -->
      <div>
        <h4 class="text-xs font-mono font-semibold uppercase tracking-wider text-[#171717] dark:text-white mb-4">
          Ratio Tools
        </h4>
        <ul class="space-y-2.5 text-sm text-[#4d4d4d] dark:text-[#a1a1a1]">
          <li><a href="/16-9-calculator" class="hover:text-[#171717] dark:hover:text-white transition-colors">16:9 Widescreen</a></li>
          <li><a href="/9-16-calculator" class="hover:text-[#171717] dark:hover:text-white transition-colors">9:16 Vertical Video</a></li>
          <li><a href="/4-3-calculator" class="hover:text-[#171717] dark:hover:text-white transition-colors">4:3 Standard Display</a></li>
          <li><a href="/1-1-calculator" class="hover:text-[#171717] dark:hover:text-white transition-colors">1:1 Square Grid</a></li>
          <li><a href="/3-2-calculator" class="hover:text-[#171717] dark:hover:text-white transition-colors">3:2 DSLR Photography</a></li>
          <li><a href="/21-9-calculator" class="hover:text-[#171717] dark:hover:text-white transition-colors">21:9 Ultrawide Cinema</a></li>
        </ul>
      </div>

      <!-- Specialized Utilities -->
      <div>
        <h4 class="text-xs font-mono font-semibold uppercase tracking-wider text-[#171717] dark:text-white mb-4">
          Calculators
        </h4>
        <ul class="space-y-2.5 text-sm text-[#4d4d4d] dark:text-[#a1a1a1]">
          <li><a href="/#workbench" class="hover:text-[#171717] dark:hover:text-white transition-colors">Image Ratio Finder</a></li>
          <li><a href="/proportional-resize-calculator" class="hover:text-[#171717] dark:hover:text-white transition-colors">Proportional Resizer</a></li>
          <li><a href="/crop-calculator" class="hover:text-[#171717] dark:hover:text-white transition-colors">Crop &amp; Framing Solver</a></li>
          <li><a href="/image-aspect-ratio" class="hover:text-[#171717] dark:hover:text-white transition-colors">Social Platform Cheatsheet</a></li>
          <li><a href="/image-aspect-ratio#resolutions" class="hover:text-[#171717] dark:hover:text-white transition-colors">Common Resolutions Table</a></li>
        </ul>
      </div>

      <!-- Legal & Company Links -->
      <div>
        <h4 class="text-xs font-mono font-semibold uppercase tracking-wider text-[#171717] dark:text-white mb-4">
          Company &amp; Legal
        </h4>
        <ul class="space-y-2.5 text-sm text-[#4d4d4d] dark:text-[#a1a1a1]">
          <li><a href="/about" class="hover:text-[#171717] dark:hover:text-white transition-colors">About Us</a></li>
          <li><a href="/contact" class="hover:text-[#171717] dark:hover:text-white transition-colors">Contact Us</a></li>
          <li><a href="/privacy" class="hover:text-[#171717] dark:hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-[#171717] dark:hover:text-white transition-colors">Terms &amp; Conditions</a></li>
          <li><a href="/sitemap.xml" target="_blank" class="hover:text-[#171717] dark:hover:text-white transition-colors">Sitemap</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom hairline & credits -->
    <div class="mt-12 pt-8 border-t border-[#ebebeb] dark:border-[#262626] flex flex-col sm:flex-row items-center justify-between text-xs text-[#8f8f8f] dark:text-[#a1a1a1] gap-4">
      <p>© {currentYear} AspectRatioKit. Built for developers, designers, and creators.</p>
      <div class="flex items-center gap-4">
        <span>100% Client-Side Engine</span>
        <span>•</span>
        <span>Zero Server Uploads</span>
      </div>
    </div>
  </div>
</footer>
