---
interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;

const navLinks = [
  { href: '/', label: 'All Tools' },
  { href: '/16-9-calculator', label: '16:9' },
  { href: '/9-16-calculator', label: '9:16' },
  { href: '/4-3-calculator', label: '4:3' },
  { href: '/1-1-calculator', label: '1:1' },
  { href: '/proportional-resize-calculator', label: 'Resizer' },
  { href: '/crop-calculator', label: 'Crop' },
  { href: '/image-aspect-ratio', label: 'Guide & Presets' },
];

const secondaryLinks = [
  { href: '/about', label: 'About Us' },
  { href: '/contact', label: 'Contact Us' },
  { href: '/privacy', label: 'Privacy Policy' },
  { href: '/terms', label: 'Terms & Conditions' },
];
---

<header class="sticky top-0 z-50 bg-[#fafafa]/90 dark:bg-[#0a0a0a]/90 backdrop-blur-md border-b border-[#ebebeb] dark:border-[#262626] transition-colors duration-150">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-7 h-7 rounded-md bg-[#171717] dark:bg-[#ffffff] text-white dark:text-[#171717] flex items-center justify-center font-mono font-bold text-xs tracking-tighter transition-transform group-hover:scale-105">
        <span class="text-[#50e3c2] dark:text-[#0070f3] text-[10px] mr-[1px]">16</span>:<span class="text-[10px] ml-[1px]">9</span>
      </div>
      <span class="font-semibold text-base tracking-tight text-[#171717] dark:text-[#ffffff] font-sans">
        AspectRatio<span class="text-[#8f8f8f] font-normal">Kit</span>
      </span>
    </a>

    <!-- Desktop Navigation links -->
    <nav class="hidden lg:flex items-center gap-1 text-[13px] font-medium text-[#4d4d4d] dark:text-[#a1a1a1]">
      {navLinks.map((link) => {
        const isActive = activePath === link.href;
        return (
          <a
            href={link.href}
            class={`px-2.5 py-1.5 rounded-full transition-colors ${
              isActive
                ? 'text-[#171717] dark:text-[#ffffff] bg-[#ebebeb]/70 dark:bg-[#262626] font-semibold'
                : 'hover:text-[#171717] dark:hover:text-[#ffffff] hover:bg-[#f2f2f2] dark:hover:bg-[#1a1a1a]'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Controls (Theme Toggle, Client-Side Badge, Mobile Menu Toggle) -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Theme Toggle Button -->
      <div class="relative" id="theme-menu-container">
        <button
          type="button"
          id="theme-toggle-btn"
          aria-label="Toggle theme (System, Light, Dark)"
          class="flex items-center justify-center w-8 h-8 rounded-full border border-[#ebebeb] dark:border-[#262626] bg-[#ffffff] dark:bg-[#141414] text-[#171717] dark:text-[#ededed] hover:border-[#171717] dark:hover:border-[#ededed] transition-all shadow-xs cursor-pointer"
          title="Theme: System first (Click to toggle)"
        >
          <!-- Sun Icon (Light Mode) -->
          <svg id="theme-icon-sun" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="5" stroke-width="2"></circle>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
          </svg>
          <!-- Moon Icon (Dark Mode) -->
          <svg id="theme-icon-moon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
          </svg>
          <!-- Monitor Icon (System Mode) -->
          <svg id="theme-icon-system" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <rect x="2" y="3" width="20" height="14" rx="2" stroke-width="2"></rect>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 21h8m-4-4v4"></path>
          </svg>
        </button>
      </div>

      <!-- Privacy Trust Badge (Desktop) -->
      <div class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#ffffff] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#262626] text-[11px] font-mono text-[#171717] dark:text-[#ededed] shadow-[0_1px_1px_rgba(0,0,0,0.03)]" title="All processing occurs 100% locally in your browser">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>100% Client-Side</span>
      </div>

      <!-- Action Button -->
      <a
        href="#workbench"
        class="hidden sm:inline-flex items-center justify-center px-3.5 py-1.5 rounded-full bg-[#171717] dark:bg-[#ededed] text-white dark:text-[#171717] text-[13px] font-medium hover:bg-[#333333] dark:hover:bg-[#ffffff] transition-colors shadow-xs"
      >
        Open Tools
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        id="mobile-menu-btn"
        aria-label="Open navigation menu"
        aria-expanded="false"
        class="lg:hidden flex items-center justify-center w-8 h-8 rounded-md border border-[#ebebeb] dark:border-[#262626] bg-[#ffffff] dark:bg-[#141414] text-[#171717] dark:text-[#ededed] hover:border-[#171717] dark:hover:border-[#ededed] transition-colors cursor-pointer"
      >
        <svg id="menu-icon-open" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="menu-icon-close" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Drawer -->
  <div
    id="mobile-drawer"
    class="hidden lg:hidden border-b border-[#ebebeb] dark:border-[#262626] bg-[#ffffff] dark:bg-[#0a0a0a] px-4 pt-3 pb-6 space-y-4 shadow-lg animate-in slide-in-from-top-2"
  >
    <div class="space-y-1">
      <div class="text-[11px] font-mono uppercase tracking-wider text-[#8f8f8f] px-3 py-1 font-semibold">
        Calculators &amp; Tools
      </div>
      <div class="grid grid-cols-2 gap-1">
        {navLinks.map((link) => {
          const isActive = activePath === link.href;
          return (
            <a
              href={link.href}
              class={`px-3 py-2 rounded-lg text-xs font-medium transition-colors ${
                isActive
                  ? 'bg-[#171717] text-white dark:bg-[#ededed] dark:text-[#171717] font-semibold'
                  : 'text-[#4d4d4d] dark:text-[#a1a1a1] hover:bg-[#fafafa] dark:hover:bg-[#1a1a1a] hover:text-[#171717] dark:hover:text-[#ffffff]'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </div>
    </div>

    <!-- Company & Legal Links in Mobile Menu -->
    <div class="pt-3 border-t border-[#ebebeb] dark:border-[#262626] space-y-1">
      <div class="text-[11px] font-mono uppercase tracking-wider text-[#8f8f8f] px-3 py-1 font-semibold">
        Information &amp; Support
      </div>
      <div class="grid grid-cols-2 gap-1">
        {secondaryLinks.map((link) => {
          const isActive = activePath === link.href;
          return (
            <a
              href={link.href}
              class={`px-3 py-2 rounded-lg text-xs font-medium transition-colors ${
                isActive
                  ? 'bg-[#171717] text-white dark:bg-[#ededed] dark:text-[#171717] font-semibold'
                  : 'text-[#4d4d4d] dark:text-[#a1a1a1] hover:bg-[#fafafa] dark:hover:bg-[#1a1a1a] hover:text-[#171717] dark:hover:text-[#ffffff]'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </div>
    </div>

    <!-- Mobile Theme Selector -->
    <div class="pt-3 border-t border-[#ebebeb] dark:border-[#262626] flex items-center justify-between px-3">
      <span class="text-xs text-[#737373] dark:text-[#8f8f8f] font-mono">Theme Mode</span>
      <div class="inline-flex rounded-lg border border-[#ebebeb] dark:border-[#262626] p-0.5 bg-[#fafafa] dark:bg-[#141414]">
        <button
          type="button"
          data-set-theme="system"
          class="theme-pill px-2.5 py-1 text-[11px] font-mono rounded-md transition-all text-[#171717] dark:text-[#ededed]"
        >
          System
        </button>
        <button
          type="button"
          data-set-theme="light"
          class="theme-pill px-2.5 py-1 text-[11px] font-mono rounded-md transition-all text-[#737373] dark:text-[#8f8f8f]"
        >
          Light
        </button>
        <button
          type="button"
          data-set-theme="dark"
          class="theme-pill px-2.5 py-1 text-[11px] font-mono rounded-md transition-all text-[#737373] dark:text-[#8f8f8f]"
        >
          Dark
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  function initHeader() {
    // 1. Theme Controller
    const themeBtn = document.getElementById('theme-toggle-btn');
    const sunIcon = document.getElementById('theme-icon-sun');
    const moonIcon = document.getElementById('theme-icon-moon');
    const systemIcon = document.getElementById('theme-icon-system');
    const themePills = document.querySelectorAll<HTMLButtonElement>('[data-set-theme]');

    function getThemePreference(): 'system' | 'light' | 'dark' {
      const stored = localStorage.getItem('theme');
      if (stored === 'light' || stored === 'dark') return stored;
      return 'system';
    }

    function applyTheme(theme: 'system' | 'light' | 'dark') {
      const mql = window.matchMedia('(prefers-color-scheme: dark)');
      const isDark = theme === 'dark' || (theme === 'system' && mql.matches);

      if (isDark) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }

      // Update Icon
      sunIcon?.classList.add('hidden');
      moonIcon?.classList.add('hidden');
      systemIcon?.classList.add('hidden');

      if (theme === 'system') {
        systemIcon?.classList.remove('hidden');
        themeBtn?.setAttribute('title', `Theme: System (${mql.matches ? 'Dark' : 'Light'}) - Click to switch`);
      } else if (theme === 'light') {
        sunIcon?.classList.remove('hidden');
        themeBtn?.setAttribute('title', 'Theme: Light - Click to switch');
      } else {
        moonIcon?.classList.remove('hidden');
        themeBtn?.setAttribute('title', 'Theme: Dark - Click to switch');
      }

      // Update Pills in Mobile Menu
      themePills.forEach((pill) => {
        const pTheme = pill.getAttribute('data-set-theme');
        if (pTheme === theme) {
          pill.className = 'theme-pill px-2.5 py-1 text-[11px] font-mono rounded-md transition-all bg-white dark:bg-[#262626] text-[#171717] dark:text-[#ededed] font-semibold shadow-xs';
        } else {
          pill.className = 'theme-pill px-2.5 py-1 text-[11px] font-mono rounded-md transition-all text-[#737373] dark:text-[#8f8f8f] hover:text-[#171717] dark:hover:text-white';
        }
      });
    }

    function cycleTheme() {
      const current = getThemePreference();
      let next: 'system' | 'light' | 'dark' = 'system';
      if (current === 'system') next = 'light';
      else if (current === 'light') next = 'dark';
      else if (current === 'dark') next = 'system';

      if (next === 'system') {
        localStorage.removeItem('theme');
      } else {
        localStorage.setItem('theme', next);
      }
      applyTheme(next);
    }

    themeBtn?.addEventListener('click', cycleTheme);

    themePills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const selected = pill.getAttribute('data-set-theme') as 'system' | 'light' | 'dark';
        if (selected === 'system') {
          localStorage.removeItem('theme');
        } else {
          localStorage.setItem('theme', selected);
        }
        applyTheme(selected);
      });
    });

    // Initialize UI on mount
    applyTheme(getThemePreference());

    // 2. Mobile Drawer Controller
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileDrawer = document.getElementById('mobile-drawer');
    const openIcon = document.getElementById('menu-icon-open');
    const closeIcon = document.getElementById('menu-icon-close');

    if (mobileBtn && mobileDrawer && openIcon && closeIcon) {
      mobileBtn.addEventListener('click', () => {
        const isClosed = mobileDrawer.classList.contains('hidden');
        if (isClosed) {
          mobileDrawer.classList.remove('hidden');
          openIcon.classList.add('hidden');
          closeIcon.classList.remove('hidden');
          mobileBtn.setAttribute('aria-expanded', 'true');
        } else {
          mobileDrawer.classList.add('hidden');
          openIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
          mobileBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeader);
  } else {
    initHeader();
  }
</script>
