---
import BaseLayout from '../layouts/BaseLayout.astro';
import AspectRatioWorkbench from '../components/AspectRatioWorkbench.astro';

const popular169Resolutions = [
  { label: '8K Ultra HD', w: 7680, h: 4320, use: 'Next-gen cinema & broadcasting' },
  { label: '4K Ultra HD', w: 3840, h: 2160, use: 'Modern TVs, 4K monitors & YouTube UHD' },
  { label: '2K QHD (1440p)', w: 2560, h: 1440, use: 'PC Gaming monitors & high-end laptops' },
  { label: 'Full HD (1080p)', w: 1920, h: 1080, use: 'Standard streaming, laptops, presentations' },
  { label: 'HD Ready (720p)', w: 1280, h: 720, use: 'Standard web video & video calls' },
  { label: 'Standard (360p)', w: 640, h: 360, use: 'Mobile low-bandwidth preview' },
];
---

<BaseLayout
  title="16:9 Aspect Ratio Calculator - Free Widescreen Dimension Tool"
  description="Calculate exact 16:9 widescreen dimensions for 4K, 1080p, and 720p video. Convert width to height or height to width instantly in your browser."
  canonicalPath="/16-9-calculator"
  activeNav="/16-9-calculator"
>
  <div class="py-12 bg-[#fafafa] border-b border-[#ebebeb]">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-[#ebebeb] text-xs font-mono uppercase text-[#0070f3] mb-4">
        <span>Standard Widescreen Ratio</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-semibold tracking-tight text-[#171717]">
        16:9 Aspect Ratio Calculator
      </h1>
      <p class="mt-3 text-base text-[#4d4d4d] max-w-xl mx-auto">
        The international standard format for HDTV, online video platforms (YouTube, Vimeo), desktop monitors, and modern gaming displays.
      </p>
    </div>
  </div>

  <AspectRatioWorkbench
    initialMode="calculator"
    defaultRatioW={16}
    defaultRatioH={9}
    defaultWidth={1920}
    defaultHeight={1080}
  />

  <!-- Resolution Reference Table -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h2 class="text-xl font-semibold text-[#171717] mb-4">Standard 16:9 Resolutions</h2>
    <div class="bg-white rounded-xl border border-[#ebebeb] overflow-hidden whisper-shadow">
      <table class="w-full text-left text-xs sm:text-sm">
        <thead class="bg-[#fafafa] border-b border-[#ebebeb] text-[#8f8f8f] font-mono uppercase text-[11px]">
          <tr>
            <th class="p-3.5">Standard Label</th>
            <th class="p-3.5">Dimensions (W × H)</th>
            <th class="p-3.5">Total Megapixels</th>
            <th class="p-3.5">Typical Usage</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#ebebeb] text-[#171717]">
          {popular169Resolutions.map((res) => (
            <tr class="hover:bg-[#fafafa] transition-colors">
              <td class="p-3.5 font-medium">{res.label}</td>
              <td class="p-3.5 font-mono text-[#0070f3] font-semibold">{res.w} × {res.h}</td>
              <td class="p-3.5 font-mono">{((res.w * res.h) / 1000000).toFixed(1)} MP</td>
              <td class="p-3.5 text-[#4d4d4d]">{res.use}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Explanation -->
    <div class="mt-12 space-y-4 text-sm text-[#4d4d4d] leading-relaxed">
      <h3 class="text-base font-semibold text-[#171717]">Why 16:9 Became the Universal Standard</h3>
      <p>
        In the late 1980s, Dr. Kerns H. Powers proposed 16:9 (1.78:1) as an optimal mathematical compromise between the classic 4:3 TV format and ultra-wide cinematic formats like 2.39:1 Cinemascope. A 16:9 frame allows both 4:3 content and widescreen cinema to fit onto the same display with minimal letterboxing or pillarboxing area wasted.
      </p>
    </div>
  </section>
</BaseLayout>
