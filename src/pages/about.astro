---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About Us - AspectRatioKit | Mission & Client-Side Architecture"
  description="Discover the story and engineering behind AspectRatioKit. Built to give designers, developers, and photographers a fast, 100% private aspect ratio toolkit."
  canonicalPath="/about"
  activeNav="/about"
>
  <!-- Hero Section -->
  <div class="py-16 bg-[#fafafa] dark:bg-[#0a0a0a] border-b border-[#ebebeb] dark:border-[#262626] transition-colors duration-150">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white dark:bg-[#141414] border border-[#ebebeb] dark:border-[#262626] text-xs font-mono uppercase text-[#0070f3] mb-4">
        <span>About AspectRatioKit</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-semibold tracking-tight text-[#171717] dark:text-white">
        Engineered for Precision &amp; Absolute Privacy
      </h1>
      <p class="mt-4 text-base sm:text-lg text-[#4d4d4d] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed">
        AspectRatioKit was built to replace ad-cluttered, slow calculator utilities with a clean, client-side, developer-grade toolkit.
      </p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-12">
    <!-- Our Origin & Mission -->
    <section class="space-y-4">
      <h2 class="text-2xl font-semibold text-[#171717] dark:text-white tracking-tight">Our Mission</h2>
      <p class="text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
        Modern creators frequently jump between image editors, video timelines, and responsive CSS stylesheets. Every day, designers and video editors need to calculate missing dimensions, check whether an image fits 16:9 or 4:3 without letterboxing, or convert photo print inches into 300 DPI pixels.
      </p>
      <p class="text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
        Unfortunately, traditional online calculators are laden with invasive tracking cookies, banners, and slow server uploads. We created <strong>AspectRatioKit</strong> with a single foundational standard: <strong>100% of mathematical computation and image analysis must occur locally on your machine</strong>.
      </p>
    </section>

    <!-- Core Pillars Grid -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#141414] whisper-shadow space-y-3">
        <div class="w-8 h-8 rounded-lg bg-[#fafafa] dark:bg-[#222222] border border-[#ebebeb] dark:border-[#333333] flex items-center justify-center font-mono font-bold text-xs text-[#0070f3]">
          01
        </div>
        <h3 class="text-base font-semibold text-[#171717] dark:text-white">Zero Server Uploads</h3>
        <p class="text-xs text-[#737373] dark:text-[#a1a1a1] leading-relaxed">
          Your photos, graphics, and video thumbnails are inspected via HTML5 Canvas and FileReader APIs in browser memory. No data is ever transmitted across the network.
        </p>
      </div>

      <div class="p-6 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#141414] whisper-shadow space-y-3">
        <div class="w-8 h-8 rounded-lg bg-[#fafafa] dark:bg-[#222222] border border-[#ebebeb] dark:border-[#333333] flex items-center justify-center font-mono font-bold text-xs text-[#7928ca]">
          02
        </div>
        <h3 class="text-base font-semibold text-[#171717] dark:text-white">Mathematical Rigor</h3>
        <p class="text-xs text-[#737373] dark:text-[#a1a1a1] leading-relaxed">
          Ratios are simplified using the Euclidean Greatest Common Divisor algorithm, giving exact integer proportions without rounding errors.
        </p>
      </div>

      <div class="p-6 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#141414] whisper-shadow space-y-3">
        <div class="w-8 h-8 rounded-lg bg-[#fafafa] dark:bg-[#222222] border border-[#ebebeb] dark:border-[#333333] flex items-center justify-center font-mono font-bold text-xs text-[#10b981]">
          03
        </div>
        <h3 class="text-base font-semibold text-[#171717] dark:text-white">Zero Clutter &amp; Distraction</h3>
        <p class="text-xs text-[#737373] dark:text-[#a1a1a1] leading-relaxed">
          No popups, paywalls, or third-party ads. Designed following the Geist aesthetic with instant keyboard navigation and theme toggle support.
        </p>
      </div>
    </section>

    <!-- Technical Architecture -->
    <section class="p-8 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#141414] whisper-shadow space-y-4">
      <h2 class="text-xl font-semibold text-[#171717] dark:text-white tracking-tight">How the Platform Is Built</h2>
      <p class="text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
        AspectRatioKit is built on Astro for static site generation, ensuring instant page loads with minimal client JavaScript overhead. Styling is powered by Tailwind CSS v4 and the Geist design system, providing dark mode support, fluid responsive layouts, and accessible UI controls.
      </p>
      <div class="flex flex-wrap gap-2 pt-2">
        <span class="px-2.5 py-1 rounded bg-[#fafafa] dark:bg-[#222222] border border-[#ebebeb] dark:border-[#333333] text-xs font-mono text-[#171717] dark:text-[#ededed]">HTML5 Canvas API</span>
        <span class="px-2.5 py-1 rounded bg-[#fafafa] dark:bg-[#222222] border border-[#ebebeb] dark:border-[#333333] text-xs font-mono text-[#171717] dark:text-[#ededed]">Euclidean GCD Algorithm</span>
        <span class="px-2.5 py-1 rounded bg-[#fafafa] dark:bg-[#222222] border border-[#ebebeb] dark:border-[#333333] text-xs font-mono text-[#171717] dark:text-[#ededed]">Astro SSG</span>
        <span class="px-2.5 py-1 rounded bg-[#fafafa] dark:bg-[#222222] border border-[#ebebeb] dark:border-[#333333] text-xs font-mono text-[#171717] dark:text-[#ededed]">Tailwind CSS v4</span>
        <span class="px-2.5 py-1 rounded bg-[#fafafa] dark:bg-[#222222] border border-[#ebebeb] dark:border-[#333333] text-xs font-mono text-[#171717] dark:text-[#ededed]">Client-Side Memory Execution</span>
      </div>
    </section>

    <!-- Contact CTA -->
    <div class="text-center pt-6">
      <h3 class="text-lg font-semibold text-[#171717] dark:text-white">Have feedback or suggestions?</h3>
      <p class="text-sm text-[#737373] dark:text-[#a1a1a1] mt-1">
        We are constantly adding new ratio presets and visual tools for creators.
      </p>
      <div class="mt-4 flex items-center justify-center gap-3">
        <a
          href="/contact"
          class="px-5 py-2.5 rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] text-sm font-medium hover:bg-[#333333] dark:hover:bg-[#ededed] transition-all shadow-xs"
        >
          Contact the Team
        </a>
        <a
          href="/#workbench"
          class="px-5 py-2.5 rounded-full bg-white dark:bg-[#141414] border border-[#ebebeb] dark:border-[#262626] text-[#171717] dark:text-white text-sm font-medium hover:border-[#171717] dark:hover:border-white transition-all shadow-xs"
        >
          Explore Calculators
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
